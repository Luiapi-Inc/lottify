{
  "name": "lottify-v1",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:worker": "tsx watch apps/workers/src/main.ts",
    "dev:member": "next dev apps/member-web",
    "dev:admin": "next dev apps/admin-web",
    "build:backend": "tsc -p tsconfig.backend.json",
    "build:member": "NODE_ENV=production next build apps/member-web",
    "build:admin": "NODE_ENV=production next build apps/admin-web",
    "build": "pnpm build:backend && pnpm build:member && pnpm build:admin",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run",
    "test:accounting-period-backfill": "RUN_ACCOUNTING_PERIOD_BACKFILL_TEST=1 RUN_INTEGRATION_TESTS=0 vitest run tests/integration/accounting-period-backfill.integration.spec.ts",
    "test:accounting-period-contract": "RUN_ACCOUNTING_PERIOD_CONTRACT_TEST=1 RUN_INTEGRATION_TESTS=0 vitest run tests/integration/accounting-period-contract.integration.spec.ts",
    "test:accounting-period-reporting": "RUN_ACCOUNTING_PERIOD_REPORTING_TEST=1 RUN_INTEGRATION_TESTS=0 vitest run tests/integration/accounting-period-reporting.integration.spec.ts",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "openapi:spec": "tsx apps/api/scripts/generate-openapi.ts",
    "openapi:client": "openapi-typescript apps/api/openapi/openapi.json -o packages/contracts/src/generated/api.ts",
    "openapi:docs": "node apps/api/scripts/generate-api-docs.mjs",
    "openapi:generate": "pnpm openapi:spec && pnpm openapi:client && pnpm openapi:docs",
    "load:seed": "tsx tools/load-harness/seed/seed-load-fixtures.ts",
    "load:run": "node tools/load-harness/run.mjs",
    "load:assert": "tsx tools/load-harness/seed/assert-financial-effects.ts",
    "check": "pnpm prisma:generate && pnpm openapi:generate && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/jwt": "11.0.1",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/swagger": "11.4.7",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/auto-instrumentations-node": "0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/node": "10.73.0",
    "bullmq": "6.3.4",
    "express": "5.1.0",
    "ioredis": "5.8.2",
    "next": "16.3.4",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "prom-client": "15.1.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/express": "5.0.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "openapi-typescript": "7.13.0",
    "prisma": "7.10.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
