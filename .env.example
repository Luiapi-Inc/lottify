APP_ENV=local
API_PORT=3000
WORKER_HEALTH_PORT=3100
WORKER_GROUP=scheduler-outbox
DATABASE_URL=postgresql://lottify:lottify@localhost:5432/lottify?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# Withdrawal dual-control threshold in minor units (satang). G2
# `system_settings.withdrawal.dual_control_threshold` = 50,000.00 THB.
WITHDRAWAL_APPROVAL_THRESHOLD_MINOR=5000000
MEMBER_OTP_CODE_LENGTH=6
MEMBER_OTP_TTL_SECONDS=300
MEMBER_OTP_MAX_ATTEMPTS=10
MEMBER_OTP_RESEND_COOLDOWN_SECONDS=60
MEMBER_OTP_REQUEST_WINDOW_SECONDS=900
MEMBER_OTP_REQUEST_MAX_PER_WINDOW=5
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_LOCK_TTL_SECONDS=30
OTEL_SERVICE_NAME=lottify-api
# OTLP collector base endpoint shared by all telemetry signals (spec semantics).
# Each signal appends its own path: /v1/traces (traces) and /v1/metrics (metrics).
# Leave empty to disable OTLP export. Examples:
#   http://otel-collector:4318
#   http://127.0.0.1:4318/v1
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
SENTRY_DSN=
# Comma-separated alert webhook endpoints that receive operational alerts (empty = none).
OPERATIONAL_ALERT_WEBHOOK_URLS=
# Bearer token required on /metrics and /internal/health/* (empty = open; set in production).
OPS_AUTH_TOKEN=
LOG_LEVEL=info
LOTTIFY_API_ORIGIN=http://localhost:3000
