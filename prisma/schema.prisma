generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  memberId         String    @map("member_id") @db.Uuid
  deviceId         String?   @map("device_id")
  /// G2 session forensics carried by the cutover ETL (decision D4). The UA string is *not* a device
  /// identity, so `device_id` is deliberately left unpopulated for migrated sessions.
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  familyId         String    @map("family_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  replacedById     String?   @map("replaced_by_id") @db.Uuid
  version          Int       @default(1)
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([memberId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Member {
  id        String         @id @default(uuid()) @db.Uuid
  phone     String         @unique
  /// G2 legacy identifier carried by the G2->G3 cutover ETL (decision D1). G2 identity is
  /// email+password and G3 identity is phone+OTP, so the migrated Member's only real identifier
  /// needs a home or it is destroyed irreversibly at cutover. NULL for G3-native Members.
  /// Unique so one legacy address can never attach to two Members. Self-service email claim/login
  /// is deferred; login recovery for legacy Members stays an ops re-registration path.
  legacyEmail String?      @unique @map("legacy_email")
  status    String         @default("ACTIVE")
  /// Soft-deletion fact carried from G2 `users.deleted_at` (decision D2); NULL = not deleted.
  deletedAt DateTime?      @map("deleted_at")
  fullName        String?   @map("full_name")
  dateOfBirth     DateTime? @map("date_of_birth") @db.Date
  province        String?
  profileUpdatedAt DateTime? @map("profile_updated_at")
  /// Member login credential (CR #141: phone + password replaced phone + OTP as
  /// the login channel). Encoded as the shared `scrypt-v1$<salt>$<key>` format
  /// used by Admin credentials — plaintext is never stored. NULL for a Member
  /// that has not enrolled a password yet (every pre-CR Member, plus Members
  /// created without one by the cutover ETL); such a Member is routed to the
  /// PASSWORD_ENROLL OTP flow instead of being locked out.
  passwordHash      String?   @map("password_hash")
  passwordUpdatedAt DateTime? @map("password_updated_at")
  /// Bounded brute-force defence for the password login channel (CR #141). The
  /// OTP channel had per-purpose attempt limits; the password channel must not
  /// be a cheaper oracle, so consecutive failures lock the credential for
  /// `MEMBER_LOGIN_LOCKOUT_SECONDS` exactly like the Admin login path. A lock
  /// never disables the account: it expires on its own.
  failedLoginAttempts Int      @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  devices   MemberDevice[]
  otpChallenges MemberOtpChallenge[]
  deposits  PaymentDeposit[]
  quotes    BettingQuote[]
  betOrders BetOrder[]
  settlementOrders SettlementOrder[]
  payoutDestinations PayoutDestination[]
  withdrawals PaymentWithdrawal[]
  termsAcceptances MemberTermsAcceptance[]
  capabilityRestrictions CapabilityRestriction[]
  verificationRecords MemberVerificationRecord[]
  kycStatus MemberKycStatus?

  @@map("members")
}

/// Versioned Member Terms document. Only a PUBLISHED version inside its
/// effective window is "currently required"; published content is immutable.
model MemberTermsDocument {
  id                  String    @id @default(uuid()) @db.Uuid
  code                String
  version             Int
  revision            Int       @default(1)
  state               String
  title               String
  body                String
  contentDigest       String    @map("content_digest")
  policyVersion       String    @map("policy_version")
  effectiveFrom       DateTime  @map("effective_from")
  effectiveUntil      DateTime? @map("effective_until")
  reason              String?
  createdByAdminId    String?   @map("created_by_admin_id") @db.Uuid
  publishedAt         DateTime? @map("published_at")
  publishedByAdminId  String?   @map("published_by_admin_id") @db.Uuid
  approvalEvidenceRef String?   @map("approval_evidence_ref")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  acceptances         MemberTermsAcceptance[]

  @@unique([code, version])
  @@index([state, effectiveFrom, effectiveUntil])
  @@map("member_terms_documents")
}

/// Immutable record that a Member accepted an exact Terms version at an instant.
/// One acceptance per Member + Terms version; the accepted content digest is
/// snapshotted so a later Terms change can never rewrite what was accepted.
model MemberTermsAcceptance {
  id              String             @id @default(uuid()) @db.Uuid
  memberId        String             @map("member_id") @db.Uuid
  documentId      String             @map("document_id") @db.Uuid
  documentCode    String             @map("document_code")
  documentVersion Int                @map("document_version")
  contentDigest   String             @map("content_digest")
  source          String
  acceptedAt      DateTime           @map("accepted_at")
  evidence        Json
  correlationId   String             @map("correlation_id")
  createdAt       DateTime           @default(now()) @map("created_at")
  member          Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  document        MemberTermsDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([memberId, documentId])
  @@index([memberId, acceptedAt])
  @@map("member_terms_acceptances")
}

/// KYC/Risk persistence for Member capability readiness (Ticket 06). A
/// Capability Restriction is an independent per-capability control — never one
/// overloaded account status — carrying source, reason, effective period and an
/// actor-or-policy reference so the restriction is reproducible. It maps to the
/// locked `BET_BLOCKED`/`WITHDRAWAL_BLOCKED`/`DEPOSIT_BLOCKED`/`LOGIN_BLOCKED`/
/// `PROMOTION_BLOCKED` set via the Member context domain rules.
model CapabilityRestriction {
  id               String   @id @default(uuid()) @db.Uuid
  memberId         String   @map("member_id") @db.Uuid
  type             String
  source           String
  reason           String
  effectiveFrom    DateTime @map("effective_from")
  effectiveUntil   DateTime? @map("effective_until")
  actorOrPolicyRef String   @map("actor_or_policy_ref")
  createdByAdminId String?  @map("created_by_admin_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  member           Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([memberId, type, effectiveFrom])
  @@map("member_capability_restrictions")
}

/// Verification records (Ticket 06). Verification freshness is explicit per
/// verification type: each record carries `verifiedAt`, source, evidence
/// references, an optional expiry and an optional reverification-policy
/// reference, and an expired verification is never treated as valid.
model MemberVerificationRecord {
  id                     String   @id @default(uuid()) @db.Uuid
  memberId               String   @map("member_id") @db.Uuid
  type                   String
  verifiedAt             DateTime @map("verified_at")
  source                 String
  evidenceRefs           Json     @map("evidence_refs")
  expiresAt              DateTime? @map("expires_at")
  reverificationPolicyRef String?  @map("reverification_policy_ref")
  createdAt              DateTime @default(now()) @map("created_at")
  member                 Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([memberId, type, verifiedAt])
  @@map("member_verification_records")
}

/// Normalized KYC state (Ticket 06). The latest canonical, provider-independent
/// outcome for a Member — never a vendor status. One row per Member (upsert).
model MemberKycStatus {
  id            String   @id @default(uuid()) @db.Uuid
  memberId      String   @unique @map("member_id") @db.Uuid
  outcome       String
  policyVersion String   @map("policy_version")
  evidenceRefs  Json     @map("evidence_refs")
  source        String
  evaluatedAt   DateTime @map("evaluated_at")
  version       Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("member_kyc_status")
}

model MemberDevice {
  id        String   @id @default(uuid()) @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("member_devices")
}

model MemberOtpChallenge {
  id            String   @id @default(uuid()) @db.Uuid
  phone         String
  purpose       String
  memberId      String?  @map("member_id") @db.Uuid
  codeHash      String   @map("code_hash")
  attemptsUsed  Int      @default(0) @map("attempts_used")
  expiresAt     DateTime @map("expires_at")
  cooldownUntil DateTime @map("cooldown_until")
  consumedAt    DateTime? @map("consumed_at")
  createdAt     DateTime @default(now()) @map("created_at")
  member        Member?  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([phone, purpose, createdAt])
  @@map("member_otp_challenges")
}

model AdminUser {
  id                                   String                          @id @default(uuid()) @db.Uuid
  email                                String                          @unique
  name                                 String
  passwordHash                         String                          @map("password_hash")
  role                                 String
  status                               String                          @default("ACTIVE")
  mfaEnabled                           Boolean                         @default(false) @map("mfa_enabled")
  mfaSecretEncrypted                   String?                         @map("mfa_secret_encrypted")
  failedLoginAttempts                  Int                             @default(0) @map("failed_login_attempts")
  lockedUntil                          DateTime?                       @map("locked_until")
  lastLoginAt                          DateTime?                       @map("last_login_at")
  createdAt                            DateTime                        @default(now()) @map("created_at")
  updatedAt                            DateTime                        @updatedAt @map("updated_at")
  sessions                             AdminAuthSession[]
  reauthEvidence                       AdminReauthEvidence[]
  accountingPeriodsCreated             AccountingPeriod[]              @relation("AccountingPeriodCreatedBy")
  approvalRequests                     AdminApprovalEvidence[]         @relation("AdminApprovalRequester")
  approvalDecisions                    AdminApprovalEvidence[]         @relation("AdminApprovalApprover")
  auditRecords                         AuditRecord[]
  accountingPeriodCancellationRequests AccountingPeriod[]              @relation("AccountingPeriodCancellationRequestedBy")
  accountingPeriodCloseRequests        AccountingPeriod[]              @relation("AccountingPeriodCloseRequestedBy")
  accountingPeriodCloseEvidence        AccountingPeriodCloseEvidence[] @relation("AccountingPeriodClosedBy")
  lotteryProductVersionsCreated        LotteryProductVersion[]         @relation("LotteryProductVersionCreatedBy")
  lotteryBetTypeVersionsCreated        LotteryBetTypeVersion[]         @relation("LotteryBetTypeVersionCreatedBy")
  lotteryDrawsCreated                  LotteryDraw[]                   @relation("LotteryDrawCreatedBy")

  @@index([status, role])
  @@map("admin_users")
}

model AdminAuthSession {
  id               String                @id @default(uuid()) @db.Uuid
  adminUserId      String                @map("admin_user_id") @db.Uuid
  refreshTokenHash String                @unique @map("refresh_token_hash")
  familyId         String                @map("family_id") @db.Uuid
  expiresAt        DateTime              @map("expires_at")
  revokedAt        DateTime?             @map("revoked_at")
  replacedById     String?               @map("replaced_by_id") @db.Uuid
  mfaVerifiedAt    DateTime?             @map("mfa_verified_at")
  ipAddress        String?               @map("ip_address")
  userAgent        String?               @map("user_agent")
  createdAt        DateTime              @default(now()) @map("created_at")
  lastUsedAt       DateTime?             @map("last_used_at")
  adminUser        AdminUser             @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  reauthEvidence   AdminReauthEvidence[]
  auditRecords     AuditRecord[]

  @@index([adminUserId, createdAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("admin_auth_sessions")
}

model AdminReauthEvidence {
  id           String                  @id @default(uuid()) @db.Uuid
  adminUserId  String                  @map("admin_user_id") @db.Uuid
  sessionId    String                  @map("session_id") @db.Uuid
  actionClass  String                  @map("action_class")
  verifiedAt   DateTime                @map("verified_at")
  expiresAt    DateTime                @map("expires_at")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")
  adminUser    AdminUser               @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  session      AdminAuthSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  approvals    AdminApprovalEvidence[]
  auditRecords AuditRecord[]

  @@index([sessionId, actionClass, expiresAt])
  @@index([adminUserId, expiresAt])
  @@map("admin_reauth_evidence")
}

model AdminApprovalEvidence {
  id                            String                         @id @default(uuid()) @db.Uuid
  action                        String
  resourceType                  String                         @map("resource_type")
  resourceId                    String                         @map("resource_id") @db.Uuid
  requesterAdminId              String                         @map("requester_admin_id") @db.Uuid
  approverAdminId               String                         @map("approver_admin_id") @db.Uuid
  requestedVersion              Int                            @map("requested_version")
  payloadHash                   String                         @map("payload_hash")
  reason                        String
  policyVersion                 String                         @map("policy_version")
  reauthEvidenceId              String                         @map("reauth_evidence_id") @db.Uuid
  correlationId                 String                         @map("correlation_id")
  approvedAt                    DateTime                       @map("approved_at")
  createdAt                     DateTime                       @default(now()) @map("created_at")
  requester                     AdminUser                      @relation("AdminApprovalRequester", fields: [requesterAdminId], references: [id], onDelete: Restrict)
  approver                      AdminUser                      @relation("AdminApprovalApprover", fields: [approverAdminId], references: [id], onDelete: Restrict)
  reauthEvidence                AdminReauthEvidence            @relation(fields: [reauthEvidenceId], references: [id], onDelete: Restrict)
  auditRecords                  AuditRecord[]
  accountingPeriodCloseEvidence AccountingPeriodCloseEvidence?
  activatedAccountingPeriod     AccountingPeriod?              @relation("AccountingPeriodActivationApproval")

  @@unique([action, resourceId])
  @@index([requesterAdminId, createdAt])
  @@index([approverAdminId, createdAt])
  @@index([correlationId])
  @@map("admin_approval_evidence")
}

model AuditRecord {
  id                            String                         @id @default(uuid()) @db.Uuid
  actorAdminId                  String                         @map("actor_admin_id") @db.Uuid
  actorRole                     String                         @map("actor_role")
  sessionId                     String                         @map("session_id") @db.Uuid
  action                        String
  resourceType                  String                         @map("resource_type")
  resourceId                    String                         @map("resource_id") @db.Uuid
  payloadHash                   String                         @map("payload_hash")
  reason                        String
  reauthEvidenceId              String?                        @map("reauth_evidence_id") @db.Uuid
  approvalId                    String?                        @map("approval_id") @db.Uuid
  correlationId                 String                         @map("correlation_id")
  outcome                       String
  createdAt                     DateTime                       @default(now()) @map("created_at")
  actor                         AdminUser                      @relation(fields: [actorAdminId], references: [id], onDelete: Restrict)
  session                       AdminAuthSession               @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  reauthEvidence                AdminReauthEvidence?           @relation(fields: [reauthEvidenceId], references: [id], onDelete: Restrict)
  approval                      AdminApprovalEvidence?         @relation(fields: [approvalId], references: [id], onDelete: Restrict)
  accountingPeriodCloseEvidence AccountingPeriodCloseEvidence?

  @@index([resourceType, resourceId, createdAt])
  @@index([actorAdminId, createdAt])
  @@index([correlationId])
  @@index([approvalId])
  @@map("audit_records")
}

model LotteryProduct {
  id           String                  @id @default(uuid()) @db.Uuid
  // D8 display metadata, carried from G2 lottery_categories. Additive: existing
  // rows keep working through the defaults, a migrated row carries the G2
  // name/slug/is_active/display_order values.
  name         String                  @default("")
  // Nullable so the unique index only constrains rows that actually have a
  // slug: Postgres treats NULLs as distinct, which is the partial-index
  // behaviour without leaving an index the Prisma schema cannot express.
  slug         String?                 @unique
  isActive     Boolean                 @default(true) @map("is_active")
  displayOrder Int                     @default(0) @map("display_order")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")
  versions     LotteryProductVersion[]
  draws        LotteryDraw[]

  @@map("lottery_products")
}

model LotteryBetType {
  id                  String                         @id @default(uuid()) @db.Uuid
  code                String                         @unique
  createdAt           DateTime                       @default(now()) @map("created_at")
  updatedAt           DateTime                       @updatedAt @map("updated_at")
  versions            LotteryBetTypeVersion[]
  productVersionLinks LotteryProductVersionBetType[]
  numberLimits        LotteryNumberLimit[]

  @@map("lottery_bet_types")
}

model LotteryBetTypeVersion {
  id                       String                         @id @default(uuid()) @db.Uuid
  betTypeId                String                         @map("bet_type_id") @db.Uuid
  version                  Int                            @default(1)
  revision                 Int                            @default(1)
  state                    String
  canonicalNumberFormat    String                         @map("canonical_number_format")
  validationPattern        String                         @map("validation_pattern")
  defaultPayout            Json                           @map("default_payout")
  minStakeMinor            BigInt                         @map("min_stake_minor")
  maxStakeMinor            BigInt                         @map("max_stake_minor")
  limitPolicyRef           String                         @map("limit_policy_ref")
  restrictionPolicyRef     String                         @map("restriction_policy_ref")
  settlementRuleVersionRef String                         @map("settlement_rule_version_ref")
  effectiveFrom            DateTime                       @map("effective_from")
  effectiveUntil           DateTime?                      @map("effective_until")
  reason                   String?
  createdByAdminId         String?                        @map("created_by_admin_id") @db.Uuid
  createdAt                DateTime                       @default(now()) @map("created_at")
  updatedAt                DateTime                       @updatedAt @map("updated_at")
  betType                  LotteryBetType                 @relation(fields: [betTypeId], references: [id], onDelete: Restrict)
  createdByAdmin           AdminUser?                     @relation("LotteryBetTypeVersionCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  productVersionLinks      LotteryProductVersionBetType[]

  @@unique([betTypeId, version])
  @@index([state, effectiveFrom, effectiveUntil])
  @@index([betTypeId, state, effectiveFrom])
  @@map("lottery_bet_type_versions")
}

model LotteryProductVersion {
  id                          String                         @id @default(uuid()) @db.Uuid
  productId                   String                         @map("product_id") @db.Uuid
  version                     Int                            @default(1)
  revision                    Int                            @default(1)
  state                       String
  timezone                    String
  scheduleTemplateRef         String                         @map("schedule_template_ref")
  resultSchemaVersionRef      String                         @map("result_schema_version_ref")
  settlementRuleVersionRef    String                         @map("settlement_rule_version_ref")
  defaultPayoutPolicyRef      String                         @map("default_payout_policy_ref")
  defaultLimitPolicyRef       String                         @map("default_limit_policy_ref")
  defaultRestrictionPolicyRef String                         @map("default_restriction_policy_ref")
  effectiveFrom               DateTime                       @map("effective_from")
  effectiveUntil              DateTime?                      @map("effective_until")
  reason                      String?
  createdByAdminId            String?                        @map("created_by_admin_id") @db.Uuid
  createdAt                   DateTime                       @default(now()) @map("created_at")
  updatedAt                   DateTime                       @updatedAt @map("updated_at")
  product                     LotteryProduct                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdByAdmin              AdminUser?                     @relation("LotteryProductVersionCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  enabledBetTypes             LotteryProductVersionBetType[]

  @@unique([productId, version])
  @@index([state, effectiveFrom, effectiveUntil])
  @@index([productId, state, effectiveFrom])
  @@map("lottery_product_versions")
}

model LotteryProductVersionBetType {
  productVersionId String                @map("product_version_id") @db.Uuid
  betTypeId        String                @map("bet_type_id") @db.Uuid
  betTypeVersionId String                @map("bet_type_version_id") @db.Uuid
  productVersion   LotteryProductVersion @relation(fields: [productVersionId], references: [id], onDelete: Restrict)
  betType          LotteryBetType        @relation(fields: [betTypeId], references: [id], onDelete: Restrict)
  betTypeVersion   LotteryBetTypeVersion @relation(fields: [betTypeVersionId], references: [id], onDelete: Restrict)

  @@id([productVersionId, betTypeId])
  @@unique([productVersionId, betTypeVersionId])
  @@index([betTypeId, betTypeVersionId])
  @@map("lottery_product_version_bet_types")
}

// Number limits (D8). G2 kept six number_limits rows (scope GLOBAL/TYPE/DRAW,
// an optional number, tiers, min_stake / max_stake / max_stake_per_bet /
// max_payout) with no G3 home. A limit resolves in the order DRAW -> TYPE ->
// GLOBAL, so a row is made resolvable by the Draw it names and by the Bet Type
// it was recorded against (G2's lottery_type_id is a per-product instance of one
// G3 Bet Type code). Amounts follow the G3 minor-unit convention
// (minor = G2 numeric(12,2) x 100) and stay nullable exactly where G2's column
// was nullable. G2's redundant DrawLotteryType column is not carried: it is a
// 1:1 re-spelling of the joined lottery_types.code (TWO_TOP <-> TWO_DIGIT_TOP)
// and therefore already implied by bet_type_id.
// The table keeps the lottery_ prefix because the G2 source table is itself
// named number_limits: the two generations' table names must stay disjoint or
// `prisma migrate deploy` cannot run over a G2 restore, which is exactly the
// cutover shape (G2 tables and G3 tables in one database, T13 design record s2).
model LotteryNumberLimit {
  id                  String          @id @default(uuid()) @db.Uuid
  scope               String
  betTypeId           String?         @map("bet_type_id") @db.Uuid
  drawId              String?         @map("draw_id") @db.Uuid
  number              String?
  tiers               Json?
  minStakeMinor       BigInt?         @map("min_stake_minor")
  maxStakeMinor       BigInt?         @map("max_stake_minor")
  maxStakePerBetMinor BigInt?         @map("max_stake_per_bet_minor")
  maxPayoutMinor      BigInt?         @map("max_payout_minor")
  isActive            Boolean         @default(true) @map("is_active")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  betType             LotteryBetType? @relation(fields: [betTypeId], references: [id], onDelete: Restrict)
  draw                LotteryDraw?    @relation(fields: [drawId], references: [id], onDelete: Restrict)
  drawBetType         LotteryDrawBetType? @relation("LotteryNumberLimitDrawBetType", fields: [drawId, betTypeId], references: [drawId, betTypeId], onDelete: Restrict)

  @@index([betTypeId, number])
  @@index([drawId, number])
  @@map("lottery_number_limits")
}

// Draw aggregate. A Draw snapshots the effective published Product/Bet-Type
// configuration at creation time so historical Draws stay reproducible and are
// never reinterpreted through a later configuration version. The lifecycle state
// transitions only through the merged draw-lifecycle state machine. The cutoff is
// a single server-authoritative instant shared by every Bet Type in the Draw.
model LotteryDraw {
  id                          String                   @id @default(uuid()) @db.Uuid
  productId                   String                   @map("product_id") @db.Uuid
  productVersionId            String                   @map("product_version_id") @db.Uuid
  occurrenceIdentity          String                   @map("occurrence_identity")
  localDate                   String                   @map("local_date")
  state                       String
  version                     Int                      @default(1)
  openAt                      DateTime                 @map("open_at")
  cutoffAt                    DateTime                 @map("cutoff_at")
  drawAt                      DateTime                 @map("draw_at")
  provenance                  String
  timezone                    String
  scheduleTemplateRef         String                   @map("schedule_template_ref")
  resultSchemaVersionRef      String                   @map("result_schema_version_ref")
  settlementRuleVersionRef    String                   @map("settlement_rule_version_ref")
  defaultPayoutPolicyRef      String                   @map("default_payout_policy_ref")
  defaultLimitPolicyRef       String                   @map("default_limit_policy_ref")
  defaultRestrictionPolicyRef String                   @map("default_restriction_policy_ref")
  resultSourceRef             String?                  @map("result_source_ref")
  overrideRevisionRef         String                   @default("") @map("override_revision_ref")
  createdByAdminId            String?                  @map("created_by_admin_id") @db.Uuid
  createdAt                   DateTime                 @default(now()) @map("created_at")
  updatedAt                   DateTime                 @updatedAt @map("updated_at")
  product                     LotteryProduct           @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdByAdmin              AdminUser?               @relation("LotteryDrawCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  betTypes                    LotteryDrawBetType[]
  overrides                   LotteryDrawOverride[]
  resultRevisions             ResultRevision[]
  numberLimits                LotteryNumberLimit[]
  settlementBatches           SettlementBatch[]
  quotes                      BettingQuote[]
  betOrders                   BetOrder[]

  @@unique([productId, occurrenceIdentity])
  @@index([productId, localDate])
  @@index([state, cutoffAt])
  @@index([cutoffAt])
  @@index([productVersionId])
  @@map("lottery_draws")
}

// Per-Draw Bet Type configuration snapshot. Stores the exact accepted payout,
// stake limits, and policy references so every Draw reproduces its decisions
// without reading live configuration.
model LotteryDrawBetType {
  id                       String      @id @default(uuid()) @db.Uuid
  drawId                   String      @map("draw_id") @db.Uuid
  betTypeId                String      @map("bet_type_id") @db.Uuid
  betTypeCode              String      @map("bet_type_code")
  betTypeVersionId         String      @map("bet_type_version_id") @db.Uuid
  canonicalNumberFormat    String      @map("canonical_number_format")
  validationPattern        String      @map("validation_pattern")
  payout                   Json        @map("payout")
  minStakeMinor            BigInt      @map("min_stake_minor")
  maxStakeMinor            BigInt      @map("max_stake_minor")
  limitPolicyRef           String      @map("limit_policy_ref")
  restrictionPolicyRef     String      @map("restriction_policy_ref")
  settlementRuleVersionRef String      @map("settlement_rule_version_ref")
  createdAt                DateTime    @default(now()) @map("created_at")
  draw                     LotteryDraw @relation(fields: [drawId], references: [id], onDelete: Cascade)
  numberLimits             LotteryNumberLimit[] @relation("LotteryNumberLimitDrawBetType")

  @@unique([drawId, betTypeId])
  @@index([betTypeVersionId])
  @@map("lottery_draw_bet_types")
}

// Versioned per-Draw Override. A Draw's effective configuration is the snapshot
// resolved against the published override chain (see draw-override.ts); each
// override records reason, effective time, actor and approval/audit evidence.
model LotteryDrawOverride {
  id                   String       @id @default(uuid()) @db.Uuid
  drawId               String       @map("draw_id") @db.Uuid
  supersedesOverrideId String?      @map("supersedes_override_id") @db.Uuid
  baselineRevisionRef  String       @map("baseline_revision_ref")
  baselineState        String       @map("baseline_state")
  effectiveAt          DateTime     @map("effective_at")
  reason               String
  actorAdminId         String       @map("actor_admin_id") @db.Uuid
  changes              Json
  diff                 Json
  impact               Json
  payloadDigest        String       @map("payload_digest")
  approvalEvidenceRef  String?      @map("approval_evidence_ref")
  auditEvidenceRef     String?      @map("audit_evidence_ref")
  status               String       @default("PROPOSED")
  publishedAt          DateTime?    @map("published_at")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  draw                 LotteryDraw  @relation(fields: [drawId], references: [id], onDelete: Cascade)
  supersedes           LotteryDrawOverride? @relation("LotteryDrawOverrideChain", fields: [supersedesOverrideId], references: [id], onDelete: Restrict)
  supersededBy         LotteryDrawOverride[] @relation("LotteryDrawOverrideChain")

  @@unique([drawId, payloadDigest])
  @@index([drawId])
  @@index([effectiveAt])
  @@map("lottery_draw_overrides")
}

// Betting Quote aggregate (Issue 44). A Quote is the server-authoritative
// resolution of a Member's bet lines against a Draw's effective configuration:
// aggregated normalized lines, resolved payout/limits/restrictions, total and
// expiry. Creation is idempotent by a scoped Idempotency-Key; every trusted
// value is computed server-side and never accepted from the client.
model BettingQuote {
  id               String              @id @default(uuid()) @db.Uuid
  memberId         String              @map("member_id") @db.Uuid
  drawId           String              @map("draw_id") @db.Uuid
  productId        String              @map("product_id") @db.Uuid
  productVersionId String              @map("product_version_id") @db.Uuid
  currency         String              @default("THB")
  totalStakeMinor  BigInt              @map("total_stake_minor")
  cutoffAt         DateTime            @map("cutoff_at")
  serverNow        DateTime            @map("server_now")
  expiresAt        DateTime            @map("expires_at")
  status           String              @default("QUOTED")
  idempotencyScope String              @map("idempotency_scope")
  idempotencyKey   String              @map("idempotency_key")
  fingerprint      String
  requestPayload   Json?               @map("request_payload")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  member           Member              @relation(fields: [memberId], references: [id], onDelete: Restrict)
  draw             LotteryDraw         @relation(fields: [drawId], references: [id], onDelete: Restrict)
  lines            BettingQuoteLine[]
  order            BetOrder?

  @@unique([idempotencyScope, idempotencyKey])
  @@index([memberId, createdAt])
  @@index([drawId])
  @@map("betting_quotes")
}

model BettingQuoteLine {
  id               String       @id @default(uuid()) @db.Uuid
  quoteId          String       @map("quote_id") @db.Uuid
  betTypeId        String       @map("bet_type_id") @db.Uuid
  betTypeCode      String       @map("bet_type_code")
  betTypeVersionId String       @map("bet_type_version_id") @db.Uuid
  canonicalNumber  String       @map("canonical_number")
  stakeMinor       BigInt       @map("stake_minor")
  resolvedPayout   Json         @map("resolved_payout")
  payoutSource     String       @map("payout_source")
  restrictions     Json         @map("restrictions")
  createdAt        DateTime     @default(now()) @map("created_at")
  quote            BettingQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, betTypeId, canonicalNumber])
  @@index([betTypeVersionId])
  @@map("betting_quote_lines")
}

// Bet Order aggregate (Issue 45). An Order is created from an authorised Quote
// and moves through the locked lifecycle state machine (`bet-order-lifecycle`).
// `version` is the optimistic-concurrency guard for every member command; the
// financial linkage columns (reservation + stake/refund transaction) prove the
// Wallet & Ledger effect that gated the terminal state.
model BetOrder {
  id                  String         @id @default(uuid()) @db.Uuid
  memberId            String         @map("member_id") @db.Uuid
  quoteId             String         @map("quote_id") @db.Uuid
  drawId              String         @map("draw_id") @db.Uuid
  productId           String         @map("product_id") @db.Uuid
  productVersionId    String         @map("product_version_id") @db.Uuid
  currency            String         @default("THB")
  state               String         @default("QUOTED")
  version             Int            @default(1)
  totalStakeMinor     BigInt         @map("total_stake_minor")
  cutoffAt            DateTime       @map("cutoff_at")
  quoteExpiresAt      DateTime       @map("quote_expires_at")
  reservationId       String?        @map("reservation_id") @db.Uuid
  stakeTransactionId  String?        @map("stake_transaction_id") @db.Uuid
  refundTransactionId String?        @map("refund_transaction_id") @db.Uuid
  rejectionReason     String?        @map("rejection_reason")
  cancellationReason  String?        @map("cancellation_reason")
  confirmIdempotencyKey String?      @map("confirm_idempotency_key")
  cancelIdempotencyKey String?       @map("cancel_idempotency_key")
  confirmedAt         DateTime?      @map("confirmed_at")
  cancelledAt         DateTime?      @map("cancelled_at")
  rejectedAt          DateTime?      @map("rejected_at")
  idempotencyScope    String         @map("idempotency_scope")
  idempotencyKey      String         @map("idempotency_key")
  fingerprint         String
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  member              Member         @relation(fields: [memberId], references: [id], onDelete: Restrict)
  quote               BettingQuote   @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  draw                LotteryDraw    @relation(fields: [drawId], references: [id], onDelete: Restrict)
  lines               BetOrderLine[]
  receipt             BetReceipt?

  @@unique([quoteId])
  @@unique([idempotencyScope, idempotencyKey])
  @@index([memberId, createdAt])
  @@index([drawId, state])
  @@index([state])
  @@map("bet_orders")
}

model BetOrderLine {
  id               String   @id @default(uuid()) @db.Uuid
  orderId          String   @map("order_id") @db.Uuid
  betTypeId        String   @map("bet_type_id") @db.Uuid
  betTypeCode      String   @map("bet_type_code")
  betTypeVersionId String   @map("bet_type_version_id") @db.Uuid
  canonicalNumber  String   @map("canonical_number")
  stakeMinor       BigInt   @map("stake_minor")
  resolvedPayout   Json     @map("resolved_payout")
  payoutSource     String   @map("payout_source")
  restrictions     Json     @map("restrictions")
  createdAt        DateTime @default(now()) @map("created_at")
  order            BetOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, betTypeId, canonicalNumber])
  @@index([betTypeVersionId])
  @@map("bet_order_lines")
}

// Immutable member-facing Bet Receipt (Issue 45). Exactly one Receipt per
// confirmed Order; `terms` is the frozen accepted-terms snapshot and
// `content_digest` is its SHA-256. A database trigger rejects any UPDATE or
// DELETE so the accepted terms can never be rewritten.
model BetReceipt {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @unique @map("order_id") @db.Uuid
  memberId      String   @map("member_id") @db.Uuid
  orderVersion  Int      @map("order_version")
  contentDigest String   @map("content_digest")
  terms         Json
  /** The exact canonical serialization that `content_digest` digests. */
  termsCanonical String  @map("terms_canonical")
  issuedAt      DateTime @default(now()) @map("issued_at")
  order         BetOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([memberId, issuedAt])
  @@map("bet_receipts")
}

// Result & Settlement context (vertical 4). A ResultRevision is the validated,
// immutable Product-shaped winning data for a Draw; a correction NEVER edits a
// confirmed Result — it creates a new revision that relationally SUPERSEDES the
// prior one. A SettlementBatch is the durable execution unit whose Member-visible
// outcome is authoritative only on COMPLETED; SettlementOrder rows are the
// per-Order checkpoints that make a crashed batch resumable without re-posting.
model ResultRevision {
  id                     String          @id @default(uuid()) @db.Uuid
  drawId                 String          @map("draw_id") @db.Uuid
  revision               Int
  state                  String
  resultSchemaVersionRef String          @map("result_schema_version_ref")
  resultSourceRef        String?         @map("result_source_ref")
  resultData             Json            @map("result_data")
  winningNumbers         Json            @map("winning_numbers")
  supersedesRevisionId   String?         @unique @map("supersedes_revision_id") @db.Uuid
  correlationId          String          @map("correlation_id")
  confirmedAt            DateTime?       @map("confirmed_at")
  confirmedByAdminId     String?         @map("confirmed_by_admin_id") @db.Uuid
  // D6 provenance. G2 recorded the actor that announced a result in
  // draw_results.announced_by, a G2 users.id that cannot be an AdminUser, so the
  // CONFIRMED revision is attributed to the DISABLED migration principal and the
  // real actor is preserved here. Typed (uuid) and queryable rather than left
  // inside result_source_ref text. Deliberately not a foreign key: an
  // ADMIN/SUPERADMIN G2 actor is not migrated as a Member (D3), and the G2 users
  // table has no G3 counterpart, so a hard FK would reject exactly the rows this
  // column exists for. NULL means "confirmed by a G3 admin", i.e. the ordinary
  // post-cutover case.
  legacyConfirmedByUserId String?        @map("legacy_confirmed_by_user_id") @db.Uuid
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")
  draw                   LotteryDraw     @relation(fields: [drawId], references: [id], onDelete: Restrict)
  supersedes             ResultRevision? @relation("ResultRevisionChain", fields: [supersedesRevisionId], references: [id], onDelete: Restrict)
  supersededBy           ResultRevision? @relation("ResultRevisionChain")
  batches                SettlementBatch[]

  @@unique([drawId, revision])
  @@index([drawId, state])
  @@map("result_revisions")
}

model SettlementBatch {
  id                 String            @id @default(uuid()) @db.Uuid
  drawId             String            @map("draw_id") @db.Uuid
  resultRevisionId   String            @map("result_revision_id") @db.Uuid
  state              String
  version            Int               @default(1)
  correlationId      String            @map("correlation_id")
  totalStakeMinor    BigInt            @default(0) @map("total_stake_minor")
  totalPayoutMinor   BigInt            @default(0) @map("total_payout_minor")
  winningOrderCount  Int               @default(0) @map("winning_order_count")
  losingOrderCount   Int               @default(0) @map("losing_order_count")
  idempotencyScope   String            @map("idempotency_scope")
  idempotencyKey     String            @map("idempotency_key")
  fingerprint        String
  startedAt          DateTime          @default(now()) @map("started_at")
