generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  memberId         String    @map("member_id") @db.Uuid
  deviceId         String?   @map("device_id")
  refreshTokenHash String    @map("refresh_token_hash")
  version          Int       @default(1)
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([memberId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AdminUser {
  id                                   String                          @id @default(uuid()) @db.Uuid
  email                                String                          @unique
  name                                 String
  passwordHash                         String                          @map("password_hash")
  role                                 String
  status                               String                          @default("ACTIVE")
  mfaEnabled                           Boolean                         @default(false) @map("mfa_enabled")
  mfaSecretEncrypted                   String?                         @map("mfa_secret_encrypted")
  failedLoginAttempts                  Int                             @default(0) @map("failed_login_attempts")
  lockedUntil                          DateTime?                       @map("locked_until")
  lastLoginAt                          DateTime?                       @map("last_login_at")
  createdAt                            DateTime                        @default(now()) @map("created_at")
  updatedAt                            DateTime                        @updatedAt @map("updated_at")
  sessions                             AdminAuthSession[]
  reauthEvidence                       AdminReauthEvidence[]
  accountingPeriodsCreated             AccountingPeriod[]              @relation("AccountingPeriodCreatedBy")
  approvalRequests                     AdminApprovalEvidence[]         @relation("AdminApprovalRequester")
  approvalDecisions                    AdminApprovalEvidence[]         @relation("AdminApprovalApprover")
  auditRecords                         AuditRecord[]
  accountingPeriodCancellationRequests AccountingPeriod[]              @relation("AccountingPeriodCancellationRequestedBy")
  accountingPeriodCloseRequests        AccountingPeriod[]              @relation("AccountingPeriodCloseRequestedBy")
  accountingPeriodCloseEvidence        AccountingPeriodCloseEvidence[] @relation("AccountingPeriodClosedBy")
  lotteryProductVersionsCreated        LotteryProductVersion[]         @relation("LotteryProductVersionCreatedBy")
  lotteryBetTypeVersionsCreated        LotteryBetTypeVersion[]         @relation("LotteryBetTypeVersionCreatedBy")

  @@index([status, role])
  @@map("admin_users")
}

model AdminAuthSession {
  id               String                @id @default(uuid()) @db.Uuid
  adminUserId      String                @map("admin_user_id") @db.Uuid
  refreshTokenHash String                @unique @map("refresh_token_hash")
  familyId         String                @map("family_id") @db.Uuid
  expiresAt        DateTime              @map("expires_at")
  revokedAt        DateTime?             @map("revoked_at")
  replacedById     String?               @map("replaced_by_id") @db.Uuid
  mfaVerifiedAt    DateTime?             @map("mfa_verified_at")
  ipAddress        String?               @map("ip_address")
  userAgent        String?               @map("user_agent")
  createdAt        DateTime              @default(now()) @map("created_at")
  lastUsedAt       DateTime?             @map("last_used_at")
  adminUser        AdminUser             @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  reauthEvidence   AdminReauthEvidence[]
  auditRecords     AuditRecord[]

  @@index([adminUserId, createdAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("admin_auth_sessions")
}

model AdminReauthEvidence {
  id           String                  @id @default(uuid()) @db.Uuid
  adminUserId  String                  @map("admin_user_id") @db.Uuid
  sessionId    String                  @map("session_id") @db.Uuid
  actionClass  String                  @map("action_class")
  verifiedAt   DateTime                @map("verified_at")
  expiresAt    DateTime                @map("expires_at")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")
  adminUser    AdminUser               @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  session      AdminAuthSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  approvals    AdminApprovalEvidence[]
  auditRecords AuditRecord[]

  @@index([sessionId, actionClass, expiresAt])
  @@index([adminUserId, expiresAt])
  @@map("admin_reauth_evidence")
}

model AdminApprovalEvidence {
  id                            String                         @id @default(uuid()) @db.Uuid
  action                        String
  resourceType                  String                         @map("resource_type")
  resourceId                    String                         @map("resource_id") @db.Uuid
  requesterAdminId              String                         @map("requester_admin_id") @db.Uuid
  approverAdminId               String                         @map("approver_admin_id") @db.Uuid
  requestedVersion              Int                            @map("requested_version")
  payloadHash                   String                         @map("payload_hash")
  reason                        String
  policyVersion                 String                         @map("policy_version")
  reauthEvidenceId              String                         @map("reauth_evidence_id") @db.Uuid
  correlationId                 String                         @map("correlation_id")
  approvedAt                    DateTime                       @map("approved_at")
  createdAt                     DateTime                       @default(now()) @map("created_at")
  requester                     AdminUser                      @relation("AdminApprovalRequester", fields: [requesterAdminId], references: [id], onDelete: Restrict)
  approver                      AdminUser                      @relation("AdminApprovalApprover", fields: [approverAdminId], references: [id], onDelete: Restrict)
  reauthEvidence                AdminReauthEvidence            @relation(fields: [reauthEvidenceId], references: [id], onDelete: Restrict)
  auditRecords                  AuditRecord[]
  accountingPeriodCloseEvidence AccountingPeriodCloseEvidence?
  activatedAccountingPeriod     AccountingPeriod?              @relation("AccountingPeriodActivationApproval")

  @@unique([action, resourceId])
  @@index([requesterAdminId, createdAt])
  @@index([approverAdminId, createdAt])
  @@index([correlationId])
  @@map("admin_approval_evidence")
}

model AuditRecord {
  id                            String                         @id @default(uuid()) @db.Uuid
  actorAdminId                  String                         @map("actor_admin_id") @db.Uuid
  actorRole                     String                         @map("actor_role")
  sessionId                     String                         @map("session_id") @db.Uuid
  action                        String
  resourceType                  String                         @map("resource_type")
  resourceId                    String                         @map("resource_id") @db.Uuid
  payloadHash                   String                         @map("payload_hash")
  reason                        String
  reauthEvidenceId              String?                        @map("reauth_evidence_id") @db.Uuid
  approvalId                    String?                        @map("approval_id") @db.Uuid
  correlationId                 String                         @map("correlation_id")
  outcome                       String
  createdAt                     DateTime                       @default(now()) @map("created_at")
  actor                         AdminUser                      @relation(fields: [actorAdminId], references: [id], onDelete: Restrict)
  session                       AdminAuthSession               @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  reauthEvidence                AdminReauthEvidence?           @relation(fields: [reauthEvidenceId], references: [id], onDelete: Restrict)
  approval                      AdminApprovalEvidence?         @relation(fields: [approvalId], references: [id], onDelete: Restrict)
  accountingPeriodCloseEvidence AccountingPeriodCloseEvidence?

  @@index([resourceType, resourceId, createdAt])
  @@index([actorAdminId, createdAt])
  @@index([correlationId])
  @@index([approvalId])
  @@map("audit_records")
}

model LotteryProduct {
  id        String                  @id @default(uuid()) @db.Uuid
  createdAt DateTime                @default(now()) @map("created_at")
  updatedAt DateTime                @updatedAt @map("updated_at")
  versions  LotteryProductVersion[]

  @@map("lottery_products")
}

model LotteryBetType {
  id                  String                         @id @default(uuid()) @db.Uuid
  code                String                         @unique
  createdAt           DateTime                       @default(now()) @map("created_at")
  updatedAt           DateTime                       @updatedAt @map("updated_at")
  versions            LotteryBetTypeVersion[]
  productVersionLinks LotteryProductVersionBetType[]

  @@map("lottery_bet_types")
}

model LotteryBetTypeVersion {
  id                       String                         @id @default(uuid()) @db.Uuid
  betTypeId                String                         @map("bet_type_id") @db.Uuid
  version                  Int                            @default(1)
  revision                 Int                            @default(1)
  state                    String
  canonicalNumberFormat    String                         @map("canonical_number_format")
  validationPattern        String                         @map("validation_pattern")
  defaultPayout            Json                           @map("default_payout")
  minStakeMinor            BigInt                         @map("min_stake_minor")
  maxStakeMinor            BigInt                         @map("max_stake_minor")
  limitPolicyRef           String                         @map("limit_policy_ref")
  restrictionPolicyRef     String                         @map("restriction_policy_ref")
  settlementRuleVersionRef String                         @map("settlement_rule_version_ref")
  effectiveFrom            DateTime                       @map("effective_from")
  effectiveUntil           DateTime?                      @map("effective_until")
  reason                   String?
  createdByAdminId         String?                        @map("created_by_admin_id") @db.Uuid
  createdAt                DateTime                       @default(now()) @map("created_at")
  updatedAt                DateTime                       @updatedAt @map("updated_at")
  betType                  LotteryBetType                 @relation(fields: [betTypeId], references: [id], onDelete: Restrict)
  createdByAdmin           AdminUser?                     @relation("LotteryBetTypeVersionCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  productVersionLinks      LotteryProductVersionBetType[]

  @@unique([betTypeId, version])
  @@index([state, effectiveFrom, effectiveUntil])
  @@index([betTypeId, state, effectiveFrom])
  @@map("lottery_bet_type_versions")
}

model LotteryProductVersion {
  id                          String                         @id @default(uuid()) @db.Uuid
  productId                   String                         @map("product_id") @db.Uuid
  version                     Int                            @default(1)
  revision                    Int                            @default(1)
  state                       String
  timezone                    String
  scheduleTemplateRef         String                         @map("schedule_template_ref")
  resultSchemaVersionRef      String                         @map("result_schema_version_ref")
  settlementRuleVersionRef    String                         @map("settlement_rule_version_ref")
  defaultPayoutPolicyRef      String                         @map("default_payout_policy_ref")
  defaultLimitPolicyRef       String                         @map("default_limit_policy_ref")
  defaultRestrictionPolicyRef String                         @map("default_restriction_policy_ref")
  effectiveFrom               DateTime                       @map("effective_from")
  effectiveUntil              DateTime?                      @map("effective_until")
  reason                      String?
  createdByAdminId            String?                        @map("created_by_admin_id") @db.Uuid
  createdAt                   DateTime                       @default(now()) @map("created_at")
  updatedAt                   DateTime                       @updatedAt @map("updated_at")
  product                     LotteryProduct                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdByAdmin              AdminUser?                     @relation("LotteryProductVersionCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  enabledBetTypes             LotteryProductVersionBetType[]

  @@unique([productId, version])
  @@index([state, effectiveFrom, effectiveUntil])
  @@index([productId, state, effectiveFrom])
  @@map("lottery_product_versions")
}

model LotteryProductVersionBetType {
  productVersionId String                @map("product_version_id") @db.Uuid
  betTypeId        String                @map("bet_type_id") @db.Uuid
  betTypeVersionId String                @map("bet_type_version_id") @db.Uuid
  productVersion   LotteryProductVersion @relation(fields: [productVersionId], references: [id], onDelete: Restrict)
  betType          LotteryBetType        @relation(fields: [betTypeId], references: [id], onDelete: Restrict)
  betTypeVersion   LotteryBetTypeVersion @relation(fields: [betTypeVersionId], references: [id], onDelete: Restrict)

  @@id([productVersionId, betTypeId])
  @@unique([productVersionId, betTypeVersionId])
  @@index([betTypeId, betTypeVersionId])
  @@map("lottery_product_version_bet_types")
}

model IdempotencyRecord {
  id           String   @id @default(uuid()) @db.Uuid
  scope        String
  key          String
  fingerprint  String
  status       String
  responseCode Int?     @map("response_code")
  responseBody Json?    @map("response_body")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  topic         String
  aggregateType String?   @map("aggregate_type")
  aggregateId   String?   @map("aggregate_id")
  payload       Json
  correlationId String?   @map("correlation_id")
  attempts      Int       @default(0)
  lockedAt      DateTime? @map("locked_at")
  lockOwner     String?   @map("lock_owner")
  publishedAt   DateTime? @map("published_at")
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([publishedAt, lockedAt, createdAt])
  @@index([topic, createdAt])
  @@map("outbox_events")
}

model LedgerAccount {
  id                     String                  @id @default(uuid()) @db.Uuid
  kind                   String
  memberId               String?                 @map("member_id") @db.Uuid
  systemCode             String?                 @map("system_code")
  bucket                 String?
  currency               String                  @default("THB")
  createdAt              DateTime                @default(now()) @map("created_at")
  postings               LedgerPosting[]
  reservationAllocations ReservationAllocation[]

  @@unique([memberId, bucket, currency])
  @@unique([systemCode, currency])
  @@index([memberId, currency])
  @@map("ledger_accounts")
}

model FinancialTransaction {
  id                     String                 @id @default(uuid()) @db.Uuid
  businessTransactionId  String                 @map("business_transaction_id")
  operationType          String                 @map("operation_type")
  correlationId          String                 @map("correlation_id")
  idempotencyScope       String                 @map("idempotency_scope")
  idempotencyKey         String                 @map("idempotency_key")
  fingerprint            String
  domainReferences       Json                   @map("domain_references")
  currency               String                 @default("THB")
  effectiveAt            DateTime               @map("effective_at")
  postedAt               DateTime               @default(now()) @map("posted_at")
  accountingPeriodId     String                 @map("accounting_period_id") @db.Uuid
  correctionKind         String?                @map("correction_kind")
  correctsTransactionId  String?                @map("corrects_transaction_id") @db.Uuid
  createdAt              DateTime               @default(now()) @map("created_at")
  postings               LedgerPosting[]
  accountingPeriod       AccountingPeriod       @relation(fields: [accountingPeriodId], references: [id], onDelete: Restrict)
  correctsTransaction    FinancialTransaction?  @relation("FinancialCorrection", fields: [correctsTransactionId], references: [id], onDelete: Restrict)
  correctionTransactions FinancialTransaction[] @relation("FinancialCorrection")
  consumedReservations   Reservation[]          @relation("ReservationConsumption")

  @@unique([idempotencyScope, idempotencyKey])
  @@index([businessTransactionId])
  @@index([correlationId])
  @@index([accountingPeriodId])
  @@index([correctsTransactionId])
  @@map("financial_transactions")
}

model AccountingPeriod {
  id                                 String                         @id @default(uuid()) @db.Uuid
  mode                               String
  generationKind                     String                         @map("generation_kind")
  effectiveStart                     DateTime                       @map("effective_start")
  effectiveEnd                       DateTime                       @map("effective_end")
  state                              String
  version                            Int                            @default(1)
  reason                             String?
  createdByAdminId                   String?                        @map("created_by_admin_id") @db.Uuid
  activationApprovalId               String?                        @unique @map("activation_approval_id") @db.Uuid
  cancellationRequestedByAdminId     String?                        @map("cancellation_requested_by_admin_id") @db.Uuid
  cancellationReason                 String?                        @map("cancellation_reason")
  cancellationRequestedAt            DateTime?                      @map("cancellation_requested_at")
  closeRequestedByAdminId            String?                        @map("close_requested_by_admin_id") @db.Uuid
  closeReason                        String?                        @map("close_reason")
  closeRequestedAt                   DateTime?                      @map("close_requested_at")
  closeReconciliationReferences      Json?                          @map("close_reconciliation_references")
  closeCheckpointReferences          Json?                          @map("close_checkpoint_references")
  closeBlockingDiscrepancyReferences Json?                          @map("close_blocking_discrepancy_references")
  closeAcceptedExceptionReferences   Json?                          @map("close_accepted_exception_references")
  createdAt                          DateTime                       @default(now()) @map("created_at")
  updatedAt                          DateTime                       @updatedAt @map("updated_at")
  financialTransactions              FinancialTransaction[]
  createdByAdmin                     AdminUser?                     @relation("AccountingPeriodCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  activationApproval                 AdminApprovalEvidence?         @relation("AccountingPeriodActivationApproval", fields: [activationApprovalId], references: [id], onDelete: Restrict)
  cancellationRequestedBy            AdminUser?                     @relation("AccountingPeriodCancellationRequestedBy", fields: [cancellationRequestedByAdminId], references: [id], onDelete: Restrict)
  closeRequestedBy                   AdminUser?                     @relation("AccountingPeriodCloseRequestedBy", fields: [closeRequestedByAdminId], references: [id], onDelete: Restrict)
  closeEvidence                      AccountingPeriodCloseEvidence?

  @@index([state, effectiveStart, effectiveEnd])
  @@index([createdByAdminId, createdAt])
  @@index([cancellationRequestedByAdminId, cancellationRequestedAt])
  @@index([closeRequestedByAdminId, closeRequestedAt])
  @@map("accounting_periods")
}

model AccountingPeriodCloseEvidence {
  id                            String                @id @default(uuid()) @db.Uuid
  accountingPeriodId            String                @unique @map("accounting_period_id") @db.Uuid
  closedAt                      DateTime              @map("closed_at")
  approvalId                    String                @unique @map("approval_id") @db.Uuid
  reconciliationReferences      Json                  @map("reconciliation_references")
  checkpointReferences          Json                  @map("checkpoint_references")
  blockingDiscrepancyReferences Json                  @map("blocking_discrepancy_references")
  acceptedExceptionReferences   Json                  @map("accepted_exception_references")
  actorAdminId                  String                @map("actor_admin_id") @db.Uuid
  auditRecordId                 String                @unique @map("audit_record_id") @db.Uuid
  createdAt                     DateTime              @default(now()) @map("created_at")
  accountingPeriod              AccountingPeriod      @relation(fields: [accountingPeriodId], references: [id], onDelete: Restrict)
  approval                      AdminApprovalEvidence @relation(fields: [approvalId], references: [id], onDelete: Restrict)
  actor                         AdminUser             @relation("AccountingPeriodClosedBy", fields: [actorAdminId], references: [id], onDelete: Restrict)
  auditRecord                   AuditRecord           @relation(fields: [auditRecordId], references: [id], onDelete: Restrict)

  @@index([actorAdminId, closedAt])
  @@map("accounting_period_close_evidence")
}

model LedgerPosting {
  id            String               @id @default(uuid()) @db.Uuid
  transactionId String               @map("transaction_id") @db.Uuid
  accountId     String               @map("account_id") @db.Uuid
  side          String
  amountMinor   BigInt               @map("amount_minor")
  createdAt     DateTime             @default(now()) @map("created_at")
  transaction   FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account       LedgerAccount        @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([accountId, createdAt])
  @@map("ledger_postings")
}

model Reservation {
  id                     String                  @id @default(uuid()) @db.Uuid
  purpose                String
  businessReference      String                  @map("business_reference")
  memberId               String                  @map("member_id") @db.Uuid
  currency               String                  @default("THB")
  amountMinor            BigInt                  @map("amount_minor")
  correlationId          String                  @map("correlation_id")
  idempotencyScope       String                  @map("idempotency_scope")
  idempotencyKey         String                  @map("idempotency_key")
  fingerprint            String
  releasedAt             DateTime?               @map("released_at")
  consumedAt             DateTime?               @map("consumed_at")
  consumingTransactionId String?                 @map("consuming_transaction_id") @db.Uuid
  createdAt              DateTime                @default(now()) @map("created_at")
  allocations            ReservationAllocation[]
  consumingTransaction   FinancialTransaction?   @relation("ReservationConsumption", fields: [consumingTransactionId], references: [id], onDelete: Restrict)

  @@unique([purpose, businessReference])
  @@unique([idempotencyScope, idempotencyKey])
  @@index([memberId, releasedAt, consumedAt])
  @@index([consumingTransactionId])
  @@map("reservations")
}

model ReservationAllocation {
  id            String        @id @default(uuid()) @db.Uuid
  reservationId String        @map("reservation_id") @db.Uuid
  accountId     String        @map("account_id") @db.Uuid
  amountMinor   BigInt        @map("amount_minor")
  createdAt     DateTime      @default(now()) @map("created_at")
  reservation   Reservation   @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  account       LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([reservationId, accountId])
  @@index([accountId, reservationId])
  @@map("reservation_allocations")
}

model ReconciliationRun {
  id               String                      @id @default(uuid()) @db.Uuid
  pair             String
  checkpointKey    String                      @map("checkpoint_key")
  fingerprint      String
  memberId         String                      @map("member_id") @db.Uuid
  currency         String                      @default("THB")
  asOf             DateTime                    @map("as_of")
  sourceRange      Json                        @map("source_range")
  sourceCheckpoint Json                        @map("source_checkpoint")
  inspectedCounts  Json                        @map("inspected_counts")
  totals           Json
  result           String
  resultSummary    Json                        @map("result_summary")
  createdAt        DateTime                    @default(now()) @map("created_at")
  discrepancies    ReconciliationDiscrepancy[]

  @@unique([pair, checkpointKey])
  @@index([memberId, currency, asOf])
  @@index([pair, asOf])
  @@map("reconciliation_runs")
}

model ReconciliationDiscrepancy {
  id                    String            @id @default(uuid()) @db.Uuid
  reconciliationRunId   String            @map("reconciliation_run_id") @db.Uuid
  identityKey           String            @map("identity_key")
  status                String
  severity              String
  expectedFacts         Json              @map("expected_facts")
  observedFacts         Json              @map("observed_facts")
  amountDifferenceMinor BigInt?           @map("amount_difference_minor")
  sourceReferences      Json              @map("source_references")
  detectedAt            DateTime          @map("detected_at")
  ownerReference        String?           @map("owner_reference")
  resolutionTrail       Json              @default("[]") @map("resolution_trail")
  resolutionEvidence    Json?             @map("resolution_evidence")
  resolvedAt            DateTime?         @map("resolved_at")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  reconciliationRun     ReconciliationRun @relation(fields: [reconciliationRunId], references: [id], onDelete: Restrict)

  @@unique([reconciliationRunId, identityKey])
  @@index([status, detectedAt])
  @@index([severity, detectedAt])
  @@map("reconciliation_discrepancies")
}
